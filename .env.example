# ---------------------------------------------------------------------------
# Token Monitor — provider credentials
# Copy to .env.local and fill only the providers you actually use.
# Nothing breaks when a key is absent: that source stays in demo mode.
# ---------------------------------------------------------------------------

# Anthropic Admin API (sk-ant-admin01-...). A normal API key will not work.
ANTHROPIC_ADMIN_KEY=

# OpenAI Admin API (sk-admin-...). A normal project key will not work.
OPENAI_ADMIN_KEY=

# OpenRouter — a normal key reads /key limits; management key reads credits.
OPENROUTER_API_KEY=
OPENROUTER_MANAGEMENT_KEY=

# Balance-only / metered providers
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
MISTRAL_API_KEY=

# Optional: token required by POST /api/ingest (self-hosted gateways, scripts)
GATEWAY_INGEST_TOKEN=

# Local subscription usage (Claude Code / Codex CLI logs).
# Leave blank to use the default home directories.
CLAUDE_CONFIG_DIR=
CODEX_HOME=

# Force the simulator on/off. By default simulation fills any source
# that has no credentials or local logs.
# TOKEN_MONITOR_DEMO=1
